#<AdxTL>@(#)0.0.0.0 $Revision$ 
#-- C.A. ZPR08 Comentarios SOH --> MFG <07/2022>
#-- C.A. ZPR04 Fecha de entrega solicitada -->  <08/2022>
# NUN05.10072023.NEW - Añado la función FUNMAUXXXX para que no entre en esta parte de código.
#                     Comentado con D.S. Creemos que no es necesario ya que pasamos la OF firme y ya tenemos estos datos completados.
# 2026-00391 - JCP.20082026.Asignación de rutas de fabricación por cliente
############################################################################

$ACTION
  #--
  Case ACTION
    When "AUTLIBMAJ"       : Gosub AUTLIBMAJ    #-- ZPR08 / MFG
    When "MFIMAJ"          : Gosub MFIMAJ       #-- ZPR08 / MFI
    When "ORDMAJ"          : Gosub ORDMAJ       #-- ZPR04 / ORD
    When "LOAMSKMBP"       : Gosub LOAMSKMBP    #-- ZPR04 / Planes de seguimiento
    When "UPDMFIMAJ"       : Gosub UPDMFIMAJ
    When "ALLCHOMAT"       : Gosub ALLCHOMAT
    When Default
  Endcase
Return


###################################################
$UPDMFIMAJ

Return


#--
$AUTLIBMAJ
  #--
  #If GFONCTION <> "FUNSTKB" and left$(GFONCTION,6) <> "FUNMAU"
  # If GFONCTION <> "FUNSTKB" # NUN05.10072023.OLD
  # NUN05.10072023.NEW
  #If GFONCTION <> "FUNSTKB" and left$(GFONCTION,6) <> "FUNMAU"
  If GFONCTION <> "FUNSTKB"
&  and GFONCTION <> "FUNTDUOF" and GFONCTION <> "YPRODSANY"
##XVT05122022 OMITIR ESTE PROCESO TAMBIÉN DESDE LA FUNCIÓN "MODIFICACIÓN OBJETIVOS"
    [F:MFG]MFGTEX = [F:SOH]SOHTEX1
  Endif
Return

#--
$MFIMAJ
  #--
  # If GFONCTION <> "FUNSTKB"                                   # NUN05.10072023.OLD
  # NUN05.10072023.NEW
#  If GFONCTION <> "FUNSTKB" and left$(GFONCTION,6) <> "FUNMAU"
  If GFONCTION <> "FUNSTKB"
&  and GFONCTION <> "FUNTDUOF" and GFONCTION <> "YPRODSANY"
##XVT05122022 OMITIR ESTE PROCESO TAMBIÉN DESDE LA FUNCIÓN "MODIFICACIÓN OBJETIVOS"
    #--
    [F:MFI]SOQTEX     = [F:SOQ]SOQTEX
    [F:MFI]DEMDLVDAT  = [F:SOQ]SHIDAT
    #--
    [F:MFI]ZALTO      = [F:SOQ]ZALTO
    [F:MFI]ZANCHO     = [F:SOQ]ZANCHO
    [F:MFI]ZLARGO     = [F:SOQ]ZLARGO

    # Creo los números de serie en función del artículo
    If !clalev([F:ZZ0]): Local File ZITMLOGO    [ZZ0] : Endif
    If !clalev([F:ZZ1]): Local File ITMMASTER   [ZZ1] : Endif
    If !clalev([F:ZZ2]): Local File YMFGSERIE   [ZZ2] : Endif
    If !clalev([F:ZZ3]): Local File YITMTECNICO [ZZ3] : Endif



    Read [ZZ1]ITM0 = [F:MFI]ITMREF
    If fstat = 0
      Read [ZZ0]ZITML0 = [ZZ1]TSICOD(1)
      If fstat = 0
        If [ZZ0]TIPOSERIE = 2  # Producto Sanycces
          Local Char PREFIJO
          Local Integer SUFIJO
          Local Char SERIE
          Local Integer I

          For I=1 To [MFI]EXTQTY
            PREFIJO = mid$([F:MFI]MFGNUM,5,7)
            SUFIJO +=1
            Case len(num$(SUFIJO))
              When 1 : SERIE = PREFIJO + "00" + num$(SUFIJO)
              When 2 : SERIE = PREFIJO + "0" + num$(SUFIJO)
              When 3 : SERIE = PREFIJO + num$(SUFIJO)
            Endcase

            Raz [ZZ2]
            [ZZ2]MFGNUM = [MFI]MFGNUM
            [ZZ2]MFGLIN = [MFI]MFGLIN
            [ZZ2]NSERIE = SERIE
            Write [ZZ2]
          Next

        Elsif [ZZ0]TIPOSERIE = 3  # Producto Noken con hidro
          Local Char PRIMERO
          Local Integer I

          Read [ZZ3]YITT0 = [MFI]ITMREF
          If fstat = 0
            If [ZZ3]VERSION <> ""
              PRIMERO = [ZZ3]VERSION
            Else
              PRIMERO = "000"
            Endif
          Endif

          For I=1 To [MFI]EXTQTY
            Local Integer WSTAT
            Local Char LCON(15)
            Call NUMERO("YSER2","",date$,"",LCON,WSTAT) From SUBANM

            Raz [ZZ2]
            [ZZ2]MFGNUM = [MFI]MFGNUM
            [ZZ2]MFGLIN = [MFI]MFGLIN
            [ZZ2]NSERIE = PRIMERO + "1005568" + LCON
            Write [ZZ2]
          Next


        Elsif [ZZ0]TIPOSERIE = 4  # Productos sin hidro
          Local Char PRIMERO
          Local Char DIA,MES,ANYO,FECHA
          Local Integer I

          Read [ZZ3]YITT0 = [MFI]ITMREF
          If fstat = 0
            If [ZZ3]VERSION <> ""
              PRIMERO = [ZZ3]VERSION
            Else
              PRIMERO = "000"
            Endif
          Endif

          DIA = num$(day(date$))
          If len(DIA) = 1 : DIA = "0" + DIA : Endif

          MES = num$(month(date$))
          If len(MES) = 1 : MES = "0" + MES : Endif

          ANYO = right$(num$(year(date$)),3)

          FECHA = DIA + MES + ANYO

          [F:MFI]LOT = PRIMERO + "1005568" + FECHA

        Endif
      Endif
    Endif


    Close Local File [ZZ0]
    Close Local File [ZZ1]
    Close Local File [ZZ2]
    Close Local File [ZZ3]

  Endif
Return

#--
$ORDMAJ
  #--
  #If GFONCTION <> "FUNSTKB" and left$(GFONCTION,6) <> "FUNMAU" # NUN05.10072023.old
  # If GFONCTION <> "FUNSTKB"                                   # NUN05.10072023.old
  # NUN05.10072023.NEW
  If GFONCTION <> "FUNSTKB" and left$(GFONCTION,6) <> "FUNMAU"
&  and GFONCTION <> "FUNTDUOF" and GFONCTION <> "YPRODSANY" and GFONCTION <> "GESMKM" and GFONCTION <> "GESMKI" and GFONCTION <> "GESSMR" and GFONCTION <> "GESPTH"
&  and GFONCTION <> "GESMTK" and GFONCTION <> "GESSTQ"
##XVT05122022 OMITIR ESTE PROCESO TAMBIÉN DESDE LA FUNCIÓN "MODIFICACIÓN OBJETIVOS"

     [F:ORDW]DEMDLVDAT  = [F:SOQ]DEMDLVDAT

    #--
    If GREP = "M"
      If !clalev([ZMFI]): Local File MFGITM [ZMFI] : Endif
      If !clalev([ZORD]): Local File ORDERS [ZORD] : Endif

      Filter [ZORD] Where VCRNUMORI = [F:ORDW]VCRNUM and ITMREF = [F:ORDW]ITMREF
      Read First
      If !fstat
        [F:ZORD]DEMDLVDAT  = [F:SOQ]SHIDAT
        Rewrite [ZORD]
        If fstat : Call FSTA("ZORD") From GLOCK : End : Endif
        Read [F:ZMFI]MFI0 = [F:ZORD]VCRNUM;[F:ZORD]VCRLIN
        [F:ZMFI]DEMDLVDAT  = [F:SOQ]SHIDAT
        Rewrite [ZMFI]
        If fstat : Call FSTA("ZMFI") From GLOCK : End : Endif
      Endif
      Filter [ZORD]
    Endif
  Endif
Return

#--
$LOAMSKMBP
  #--
  If !clalev([ZMFI]): Local File MFGITM [ZMFI] : Endif
  Read [F:ZMFI]MFI2 = [F:MFG]MFGNUM
  If !fstat
    [M:MBP]DEMDLVDAT(nolign-1) = [F:MFI]DEMDLVDAT
    Infbox num$([F:MFI]DEMDLVDAT)- num$([M:MBP]DEMDLVDAT(nolign-1))
  Endif
Return


##############################################################
######################    ACCIONES    ########################
##############################################################
##############################################################
$ALLCHOMAT
# 2026-00391.ini
  If GNAVIG(GPILNAV) = "GESSOH" Then
    Local Integer LZALLCHOMAT : LZALLCHOMAT = 1   # venimos de CRE_ALL (MFGAUTLIB)
    Gosub ASIGNAR_SUBESTADO
    LZALLCHOMAT = 0
  Endif
# 2026-00391.fin
Return


##############################################################
######################    ETIQUETAS    #######################
##############################################################
#######################################################################
# ASIGNAR_SUBESTADO
# Tratamiento de asignación de componentes de OF.
# Lógica:
#   1. Si no existe stock en ningún subestado A* -> estándar.
#   2. Si existe:
#     - si hay configuración ZCLIALT: usar el primer subestado con stock suficiente
#     - si no: A1
#   3. Si ningún subestado configurado tiene stock suficiente: usar A1
#   4. Si A1 tampoco tiene stock suficiente: asignar lo disponible en A1 y crear ruptura
# #######################################################################
# 2026-00391.ini
$ASIGNAR_SUBESTADO
Local Decimal LSTO_SUB
Local Decimal LQTADEL
Local Decimal LSHTDEL
Local Integer LRETDEL
Local Integer LCONFIG
Local Integer LOPENCA

  #------------------------------------------------------------
  # Por defecto no intervenimos.
  # GPE=0 -> continúa el tratamiento estándar.
  #------------------------------------------------------------
  GPE = 0

  #------------------------------------------------------------
  # Las globales solo existen si venimos de XYFUNMAUTF.
  # Si no existen, dejamos actuar al estándar.
  #------------------------------------------------------------
  If dim(GZMFGNUM) < 0 or dim(GZBPCORD) < 0 or dim(GSUBESTADO) < 0
    Return
  Endif

  Call ECR_TRACE("ALLCHOMAT - ITMREF="+[F:MFM]ITMREF+" BOMSEQ="+num$([F:MFM]BOMSEQ),0) From GESECRAN

  #------------------------------------------------------------
  # Limpiar variables de trabajo.
  #------------------------------------------------------------
  Raz GZMFGNUM
  Raz GZMFMSEQ
  Raz GZITMREF
  Raz GZSTOFCY
  Raz GSUBESTADO
  Raz LQTADEL
  Raz LSHTDEL
  Raz LRETDEL

  #------------------------------------------------------------
  # Solo intervenimos en creación de OF desde pedido de venta.
  #------------------------------------------------------------
  # buscar si el componente contiene subestados
  If !GSERVEUR
    If GNAVIG(GPILNAV-1) = "GESSOH"  and [F:MFG]MFGNUM <> "" Then

      #----------------------------------------------------------
      # 0. ¿Configuración ZCLIALT para cliente/artículo/planta?
      #    No -> estándar (detallada si la OF es mixta).
      #----------------------------------------------------------
      If !func ZSANLIB01.TIENE_CONFIG(GZBPCORD,[F:MFM]ITMREF,[F:MFM]MFGFCY)
        Gosub FORZAR_DETALLADA
        Call ECR_TRACE("SIN CONFIGURACION ZCLIALT - BPC="+GZBPCORD+
&                      " ITMREF="+[F:MFM]ITMREF+
&                      " FCY="+[F:MFM]MFGFCY+" -> ESTANDAR",0) From GESECRAN
        Return
      Endif

      #----------------------------------------------------------
      # 1. ¿Existe stock en algún SUBESTADO de A?
      #
      # Importante:
      # A NO cuenta.
      # Solo A1, A2, A3...
      #----------------------------------------------------------
      Local Decimal LSTO_SUB

      LSTO_SUB = func ZSANLIB01.OBTENER_STOCK_SUBESTADOS_A(
&                    [F:MFM]ITMREF,
&                    [F:MFM]MFGFCY)

      If LSTO_SUB <= 0
        # No existe stock en ningún subestado.
        # Dejamos actuar al estándar.
        Return
      Endif

      #----------------------------------------------------------
      # 2. Guardamos identificación del componente.
      #----------------------------------------------------------
      GZMFGNUM = [F:MFM]MFGNUM
      GZMFMSEQ = [F:MFM]BOMSEQ
      GZITMREF = [F:MFM]ITMREF
      GZSTOFCY = [F:MFM]MFGFCY

      #----------------------------------------------------------
      # 3. Buscar subestado configurado para cliente/artículo
      #    con cantidad suficiente.
      #----------------------------------------------------------
      GSUBESTADO = func ZSANLIB01.GET_SUBESTADO(
&                         [F:MFM]ITMREF,
&                         GZBPCORD,
&                         [F:MFM]MFGFCY,
&                         [F:MFM]RETQTY)

      #----------------------------------------------------------
      # Si no hay ninguno:
      #   -> fallback a A1
      #
      # Si GET_SUBESTADO devuelve A2/A3/...:
      #   -> usamos ese subestado.
      #----------------------------------------------------------
      If GSUBESTADO = ""
        GSUBESTADO = "A1"
      Endif

      Call ECR_TRACE(
&       "SUBESTADO SELECCIONADO - ITMREF="+GZITMREF+
&       " STA="+GSUBESTADO+
&       " QTY="+num$([F:MFM]RETQTY),0) From GESECRAN


      #----------------------------------------------------------
      # 4. El estándar puede haber creado ya una asignación
      #    global para esta línea de OF.
      #
      #    Antes de crear nuestra asignación detallada,
      #    eliminamos las asignaciones existentes mediante
      #    DELALL de STKALL.
      #
      #    LOPT = 1 -> solamente asignaciones.
      #----------------------------------------------------------
      Raz LQTADEL
      Raz LSHTDEL
      Raz LRETDEL

      Call ECR_TRACE(
&       "ANTES DELALL - MFGNUM="+[F:MFM]MFGNUM+
&       " ITMREF="+[F:MFM]ITMREF+
&       " MFGLIN="+num$([F:MFM]MFGLIN)+
&       " SEQ="+num$([F:MFM]BOMSEQ),0) From GESECRAN

      Call DELALL(
&                   10,
&                   [F:MFM]MFGNUM,
&                   [F:MFM]MFGLIN,
&                   [F:MFM]BOMSEQ,
&                   [F:MFM]ITMREF,
&                   1,
&                   LQTADEL,
&                   LSHTDEL,
&                   LRETDEL) From STKALL

      Call ECR_TRACE(
&       "DESPUES DELALL - LQTA="+num$(LQTADEL)+
&       " LSHT="+num$(LSHTDEL)+
&       " RET="+num$(LRETDEL),0) From GESECRAN


      #----------------------------------------------------------
      # 5. Control del resultado de DELALL.
      #----------------------------------------------------------
      If LRETDEL <> 0

        Call ECR_TRACE(
&         "ERROR DELALL - MFGNUM="+[F:MFM]MFGNUM+
&         " ITMREF="+[F:MFM]ITMREF+
&         " RET="+num$(LRETDEL),1) From GESECRAN

        GPE = 1
        GOK = 0
        Return

      Endif


      #----------------------------------------------------------
      # 6. Informar si realmente se ha eliminado una asignación.
      #----------------------------------------------------------
      If LQTADEL = 0

        Call ECR_TRACE(
&         "DELALL - NO SE HA ENCONTRADO ASIGNACION PARA "+
&         "MFGNUM="+[F:MFM]MFGNUM+
&         " ITMREF="+[F:MFM]ITMREF+
&         " MFGLIN="+num$([F:MFM]MFGLIN)+
&         " SEQ="+num$([F:MFM]BOMSEQ),0) From GESECRAN

      Else

        Call ECR_TRACE(
&         "DELALL - ASIGNACION ELIMINADA QTY="+
&         num$(LQTADEL),0) From GESECRAN

      Endif


      #----------------------------------------------------------
      # 7. Realizar la asignación.
      #----------------------------------------------------------
      Gosub REALIZAR_ASIGNACION

    Endif
  Endif
Return

##############################################################
# REALIZAR_ASIGNACION
#
# Asigna la cantidad solicitada sobre GSUBESTADO.
#
# Si existe stock suficiente:
#   -> asignación detallada completa
#
# Si GSUBESTADO=A1 y no hay suficiente:
#   -> asignación detallada de lo disponible
#   -> resto en ruptura
#
##############################################################
$REALIZAR_ASIGNACION

Local Decimal LDISP
Local Decimal LRESTO
Local Decimal LASIG
Local Decimal LSTOCOU
Local Integer LRET
Local Integer LERRASIG

Raz LDISP
Raz LRESTO
Raz LASIG
Raz LSTOCOU
Raz LRET
Raz LERRASIG

  #--------------------------------------------------------------
  # Obtener disponibilidad total del estado seleccionado.
  #--------------------------------------------------------------
  LDISP = func ZSANLIB01.OBTENER_STOCK_DISP(
&               GZITMREF,
&               GZSTOFCY,
&               GSUBESTADO)

  Call ECR_TRACE(
&   "DISPONIBLE "+GSUBESTADO+" - ITMREF="+GZITMREF+
&   " DISP="+num$(LDISP)+
&   " NEC="+num$([F:MFM]RETQTY),0) From GESECRAN

  #--------------------------------------------------------------
  # CASO 1
  #
  # Hay suficiente stock para cubrir toda la necesidad.
  #--------------------------------------------------------------
  If LDISP >= [F:MFM]RETQTY

    LRESTO = [F:MFM]RETQTY

    Gosub ASIGNAR_STOCK_ESTADO
    If LERRASIG : Return : Endif

    If LRESTO <> 0
      Call ECR_TRACE(
&       "ERROR: NO SE HA PODIDO ASIGNAR TODA LA CANTIDAD. RESTO="+
&       num$(LRESTO),1) From GESECRAN

      GPE = 1
      GOK = 0
      Return
    Endif

    #------------------------------------------------------------
    # MFGMAT: asignación detallada completa.
    #------------------------------------------------------------
    [F:MFM]ALLQTY = [F:MFM]RETQTY
    [F:MFM]SHTQTY = 0
    [F:MFM]ALLSTA = 5

    Gosub ACTUALIZAR_CABECERA

    GPE = 1

    Call ECR_TRACE(
&     "ASIGNACION DETALLADA "+GSUBESTADO+
&     " CREADA - QTY="+num$([F:MFM]RETQTY),0) From GESECRAN

    Return
  Endif

  #--------------------------------------------------------------
  # CASO 2
  #
  # No hay suficiente stock en el estado seleccionado.
  #
  # Solo permitimos esta situación como asignación parcial
  # cuando el estado seleccionado es A1.
  #
  # Para A2/A3/...:
  #   no hacemos una asignación parcial del subestado;
  #   el diagrama indica fallback a A1.
  #
  #--------------------------------------------------------------
  If GSUBESTADO <> "A1"

    # Volvemos a A1.
    Call ECR_TRACE(
&     "NO HAY STOCK SUFICIENTE EN "+GSUBESTADO+
&     " -> FALLBACK A1",0) From GESECRAN

    GSUBESTADO = "A1"

    LDISP = func ZSANLIB01.OBTENER_STOCK_DISP(
&                 GZITMREF,
&                 GZSTOFCY,
&                 GSUBESTADO)

  Endif

  #--------------------------------------------------------------
  # Disponibilidad A1.
  #--------------------------------------------------------------
  If LDISP > 0

    LRESTO = [F:MFM]RETQTY

    Gosub ASIGNAR_STOCK_ESTADO
    If LERRASIG : Return : Endif

  Else

    LRESTO = [F:MFM]RETQTY

  Endif

  #--------------------------------------------------------------
  # Si queda cantidad pendiente -> ruptura.
  #--------------------------------------------------------------
  If LRESTO > 0

    Local Integer LRET_RUP

    Raz LRET_RUP

    # LALL = ruptura
    # LFCY
    # LITM
    # LCHR
    # LDAT
    # LQTY
    # LQTA
    # LTYP = OF
    # LNUM
    # LLIN
    # LSEQ
    # LPRE
    # LDTE
    # LLOT
    # LSLO
    # LSTA
    # LLOC
    # LSER
    # LWRH
    # LALLQTY
    # LALLQTA
    # LDEFLOC
    # LDEFLOCTYP
    # LBPR
    # LADD
    # LSCO
    # LECC
    Call CREALL(
&                 4,
&                 GZSTOFCY,
&                 GZITMREF,
&                 0,
&                 [31/12/2999],
&                 0,
&                 LRESTO,
&                 10,
&                 GZMFGNUM,
&                 [F:MFM]MFGLIN,
&                 [F:MFM]BOMSEQ,
&                 "",
&                 [F:MFM]RETDAT,
&                 "",
&                 "",
&                 GSUBESTADO,
&                 "",
&                 "",
&                 "",
&                 0,
&                 0,
&                 "",
&                 "",
&                 "",
&                 "",
&                 1,
&                 "",
&                 LRET_RUP) From STKALL

    If LRET_RUP <> 0
      Call ECR_TRACE(
&       "ERROR CREALL RUPTURA - RET="+num$(LRET_RUP),1) From GESECRAN
      GPE = 1
      GOK = 0
      Return

    Endif

  Endif

  #--------------------------------------------------------------
  # Cantidades MFGMAT.
  #--------------------------------------------------------------
  [F:MFM]ALLQTY = [F:MFM]RETQTY - LRESTO
  [F:MFM]SHTQTY = LRESTO

  If [F:MFM]SHTQTY = 0
    [F:MFM]ALLSTA = 5
  Else
    [F:MFM]ALLSTA = 4
  Endif

  Gosub ACTUALIZAR_CABECERA

  GPE = 1

  Call ECR_TRACE(
&   "ASIGNACION A1 - ALLQTY="+num$([F:MFM]ALLQTY)+
&   " SHTQTY="+num$([F:MFM]SHTQTY)+
&   " ALLSTA="+num$([F:MFM]ALLSTA),0) From GESECRAN

Return

##############################################################
# ASIGNAR_STOCK_ESTADO
#
# Asigna LRESTO sobre las líneas STOCK disponibles del estado
# GSUBESTADO, en orden cronológico de entrada (STOCOU).
#
# Al entrar : LRESTO   = cantidad pendiente de asignar
# Al salir  : LRESTO   = cantidad que no se ha podido asignar
#             LERRASIG = 1 si algún CREALL ha fallado
##############################################################
$ASIGNAR_STOCK_ESTADO

Local Decimal LDISPLINEA
Local Decimal LCANTASIG
#Local Integer LRET
Local Integer LRETALL
Local Integer LOPENSTO
Local Integer LERRASIG

  LERRASIG = 0
  Raz LOPENSTO

  If !clalev([F:ZSTO]) Then : Local File STOCK [ZSTO] : LOPENSTO = 1 : Endif

  #------------------------------------------------------------
  # Exclusiones: si se añaden aquí (bloqueo por inventario,
  # caducidad, tipo de ubicación no asignable...), hay que
  # añadir las mismas en ZSANLIB01.OBTENER_STOCK_DISP.
  #------------------------------------------------------------
  Filter [F:ZSTO] Where STOFCY = GZSTOFCY
&                   and ITMREF = GZITMREF
&                   and STA    = GSUBESTADO
&                 Order By STOCOU

  For [F:ZSTO]

    If LRESTO <= 0 : Break : Endif

    #------------------------------------------------------------
    # Disponibilidad de esta línea STOCK.
    #------------------------------------------------------------
    LDISPLINEA = [F:ZSTO]QTYSTU - [F:ZSTO]CUMALLQTY

    If LDISPLINEA > 0

      LCANTASIG = min(LRESTO,LDISPLINEA)

      Raz LRETALL

      # LALL = 2 -> detallada
      # LFCY
      # LITM
      # LCHR
      # LDAT
      # LQTY
      # LQTA
      # LTYP = OF
      # LNUM
      # LLIN
      # LSEQ
      # LPRE
      # LDTE
      # LLOT
      # LSLO
      # LSTA
      # LLOC
      # LSER
      # LWRH
      # LALLQTY
      # LALLQTA
      # LDEFLOC
      # LDEFLOCTYP
      # LBPR
      # LADD
      # LSCO
      # LECC
      Call CREALL(
&                   2,
&                   GZSTOFCY,
&                   GZITMREF,
&                   [F:ZSTO]STOCOU,
&                   [31/12/2999],
&                   LCANTASIG,
&                   LCANTASIG,
&                   10,
&                   GZMFGNUM,
&                   [F:MFM]MFGLIN,
&                   [F:MFM]BOMSEQ,
&                   "",
&                   [F:MFM]RETDAT,
&                   [F:ZSTO]LOT,
&                   [F:ZSTO]SLO,
&                   GSUBESTADO,
&                   [F:ZSTO]LOC,
&                   "",
&                   "",
&                   0,
&                   0,
&                   "",
&                   "",
&                   "",
&                   "",
&                   1,
&                   "",
&                   LRETALL) From STKALL

      If LRETALL <> 0

        Call ECR_TRACE(
&         "ERROR CREALL - STOCOU="+num$([F:ZSTO]STOCOU)+
&         " STA="+GSUBESTADO+
&         " RET="+num$(LRET),1) From GESECRAN

        LERRASIG = 1
        GPE = 1
        GOK = 0
        Break
      Endif

      LRESTO -= LCANTASIG

      Call ECR_TRACE(
&       "CREALL OK - STA="+GSUBESTADO+
&       " STOCOU="+num$([F:ZSTO]STOCOU)+
&       " QTY="+num$(LCANTASIG),0) From GESECRAN

    Endif

  Next

  Filter [F:ZSTO]
  If LOPENSTO : Close Local File [ZSTO] : Endif

Return

##############################################################
# FORZAR_DETALLADA
#
# Componente SIN configuración ZCLIALT en una OF que tiene
# algún componente CON configuración (OF mixta):
#   -> se fuerza WALLTYP=2 para que CRE_ALL (MFGAUTLIB) haga
#      la asignación detallada estándar en vez de la global.
#
# Solo actúa dentro de CRE_ALL, que es donde existen WALLTYP
# y la máscara [M:MFGX] con todos los componentes de la OF.
##############################################################
$FORZAR_DETALLADA
Local Integer LI

  If dim(WALLTYP) < 0 or dim(GZMIXTA) < 0 : Return : Endif
  If !clalev([M:MFGX])                    : Return : Endif
  If WALLTYP <> 1                         : Return : Endif   # ya es detallada

  # Se calcula una vez por OF
  If GZMIXMFG <> [F:MFM]MFGNUM
    GZMIXMFG = [F:MFM]MFGNUM
    GZMIXTA  = 0
    For LI = 0 To [M:MFGX]NBLIG - 1
      If [M:MFGX]CPNTYP(LI) <> 5 and [M:MFGX]MATSTA(LI) <> 4 and [M:MFGX]ITMREF(LI) <> ""
        If func ZSANLIB01.TIENE_CONFIG(GZBPCORD,[M:MFGX]ITMREF(LI),[F:MFM]MFGFCY)
          GZMIXTA = 1
          Break
        Endif
      Endif
    Next LI
  Endif

  If GZMIXTA
    WALLTYP = 2
    Call ECR_TRACE("OF MIXTA - ITMREF="+[F:MFM]ITMREF+
&                  " SIN ZCLIALT -> DETALLADA ESTANDAR",0) From GESECRAN
  Endif

Return

##############################################################
# ACTUALIZAR_CABECERA
#
# Con GPE=1, CRE_ALL (MFGAUTLIB) sale antes de MAJMFG y no
# actualiza OVRALLNBR / DETALLNBR / SHTMATNBR de [F:MFG].
# Lo hacemos aquí con la misma rutina estándar.
# Solo cuando venimos del punto de entrada ALLCHOMAT.
##############################################################
$ACTUALIZAR_CABECERA

  Call ECR_TRACE("LZALLCHOMAT="+num$(LZALLCHOMAT)+
&                " MEMSTA="+num$(MEMSTA),0) From GESECRAN

  If dim(LZALLCHOMAT) < 0 : Return : Endif
  If LZALLCHOMAT <> 1     : Return : Endif
  If dim(MEMSTA) < 0      : Return : Endif

  MEMSTA = 1                       # la línea no tenía asignación previa
  Gosub MAJMFG From MFGAUTLIB

  Call ECR_TRACE("CABECERA OF - DETALLNBR="+num$([F:MFG]DETALLNBR)+
&                " OVRALLNBR="+num$([F:MFG]OVRALLNBR)+
&                " SHTMATNBR="+num$([F:MFG]SHTMATNBR),0) From GESECRAN

Return

