#############################################################################################

Subprog GESTIONA_DCA_VCR(PS_VCRNUM, PI_VCRTYP)
  Value Char PS_VCRNUM
  Value Integer PI_VCRTYP
  Call PRINT_CARTA_VCR(PS_VCRNUM, PI_VCRTYP) From YDCALIB
  Sleep 7
  Call CHECK_ESTADO(PS_VCRNUM) From YDCALIB
  Sleep 3
  If nomap = 'SANYCCES'
    Call EJECUTAR_BAT() From YDCALIB
  Endif
  If GFONCTION <> 'YDCA'
    Infbox "Envío finalizado, revisa el monitor para ver su estado."
  Endif


End
