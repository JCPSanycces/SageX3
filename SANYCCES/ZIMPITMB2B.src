$ACTION

#If GUSER="SN069" Then : Call ECR_TRACE(ACTION,0) From GESECRAN : Endif
Case ACTION
  When "IMP_APRES_MOD"        : Gosub IMP_APRES_MOD
  When Default
Endcase

Return

##############################################################
######################    ACCIONES    ########################
##############################################################
##############################################################
$IMP_APRES_MOD
# ZB2B.ini
  [M:ITM1]ZB2BCONFIGUR = [F:ITM]ZB2BCONFIGUR
  Affzo [M:ITM1]ZB2BCONFIGUR
# ZB2B.fin
Return

