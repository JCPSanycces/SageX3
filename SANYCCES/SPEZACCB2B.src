Return

##############################################################
$DEL_REGISTROS
  If !clalev([F:ZAW1]) Then : Local File ZB2BITMACC01 [F:ZAW1] : Endif
  If !clalev([F:ZAW2]) Then : Local File ZB2BITMACC02 [F:ZAW2] : Endif
  If !clalev([F:ZAW3]) Then : Local File ZB2BITMACC03 [F:ZAW3] : Endif
  If !clalev([F:ZAW4]) Then : Local File ZB2BITMACC04 [F:ZAW4] : Endif
  If !clalev([F:ZAW5]) Then : Local File ZB2BITMACC05 [F:ZAW5] : Endif
  If !clalev([F:ZAW6]) Then : Local File ZB2BITMACC06 [F:ZAW6] : Endif

  # fstat=0 borrado OK, fstat=1 no había registros (no es error)
  Delete [F:ZAW1] Where ZITM = [M:ZCB0]ZITM : If fstat>1 : GOK=0 : Endif
  Delete [F:ZAW2] Where ZITM = [M:ZCB0]ZITM : If fstat>1 : GOK=0 : Endif
  Delete [F:ZAW3] Where ZITM = [M:ZCB0]ZITM : If fstat>1 : GOK=0 : Endif
  Delete [F:ZAW4] Where ZITM = [M:ZCB0]ZITM : If fstat>1 : GOK=0 : Endif
  Delete [F:ZAW5] Where ZITM = [M:ZCB0]ZITM : If fstat>1 : GOK=0 : Endif
  Delete [F:ZAW6] Where ZITM = [M:ZCB0]ZITM : If fstat>1 : GOK=0 : Endif

  If GOK<>1
    Call ERREUR("Error al borrar los datos B2B del artículo "-[M:ZCB0]ZITM) From GESECRAN
  Endif
Return

