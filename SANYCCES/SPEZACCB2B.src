    [M:ZCB5]ZITMCODVCRU([L]LCONVC)  = [F:ZAC5]ZITMACCESORI
    [M:ZCB5]ZITMDESVCRU([L]LCONVC)  = [F:ZVA5]ZITMDES
    [M:ZCB5]ZITMORDVCRU([L]LCONVC)  = [F:ZAC5]ZITMACCESORO
    [M:ZCB5]ZITMCATB2B([L]LCONVC)   = [F:ZAC5]ZITMCATB2B
    [L]LCONVC += 1
